<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme - Material Design 3 (Light) -->
    <style name="Theme.TNSMES" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color: Purple #7C3AED -->
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorPrimaryVariant">@color/purple_primary_dark</item>
        <item name="colorOnPrimary">@color/purple_on_primary</item>
        <item name="colorPrimaryContainer">@color/purple_container</item>
        <item name="colorOnPrimaryContainer">@color/purple_on_container</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>

        <!-- Surface -->
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/bg_window</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <!-- Error -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/error_container</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/purple_primary_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Component styles -->
        <item name="materialCardStyle">@style/Widget.TNSMES.CardView</item>
    </style>

    <!-- Card style with elevation -->
    <style name="Widget.TNSMES.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.TNSMES.Button" parent="Widget.Material3.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.TNSMES.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">@color/purple_primary</item>
    </style>

    <!-- Text input -->
    <style name="Widget.TNSMES.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/purple_primary</item>
    </style>

    <!-- Toolbar -->
    <style name="Widget.TNSMES.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/white</item>
        <item name="android:background">@color/purple_primary</item>
        <!-- 紫色背景上的图标统一使用白色 -->
        <item name="colorControlNormal">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
    </style>

    <!-- Text appearance -->
    <style name="TextAppearance.TNSMES.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.TNSMES.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

</resources>
